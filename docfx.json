{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      { "files": [ "docs/**.md", "docs/toc.yml", "index.md", "toc.yml" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "OpenAC",
      "_appTitle": "OpenAC",
      "_appFooter": "OpenAC is an open-source Asheron's Call client. MIT licensed.",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/eriknihlen/OpenAC",
        "branch": "main"
      }
    },
    "sitemap": {
      "baseUrl": "https://eriknihlen.github.io/OpenAC/"
    }
  }
}
