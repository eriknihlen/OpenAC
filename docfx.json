{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ "src/AcDream.Plugin.Abstractions/AcDream.Plugin.Abstractions.csproj" ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "docs/**.md", "docs/toc.yml", "index.md", "toc.yml" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "OpenAC",
      "_appTitle": "OpenAC",
      "_appFooter": "OpenAC is an open-source Asheron's Call client. MIT licensed.",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/eriknihlen/OpenAC",
        "branch": "main"
      }
    },
    "xref": [ "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json" ],
    "sitemap": {
      "baseUrl": "https://eriknihlen.github.io/OpenAC/"
    }
  }
}
