<Project Sdk="Microsoft.NET.Sdk">
  <!-- DrakBot, the built-in bot. It depends on the plugin contract only, so
       every decision it makes is testable against a fake automation surface
       and it never reaches into the renderer, the wire protocol or client
       internals. Its ImGui windows live in AcDream.DrakBot.Ui. -->
  <PropertyGroup>
    <RootNamespace>AcDream.DrakBot</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcDream.Plugin.Abstractions\AcDream.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AcDream.DrakBot.Tests" />
  </ItemGroup>
</Project>
