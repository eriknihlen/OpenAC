		DO:	DoAll
				DoExpr {setvar[augmentNav,`nav_rikshenri`]}
				DoExpr {setvar[augmentItem,`Fiery Enhancement`]}
				SetState {service_apply_augment_nav}
	IF:	All
			Expr {getvar[augResistFrostTarget]>0}
			Expr {getcharintprop[239]<2}
